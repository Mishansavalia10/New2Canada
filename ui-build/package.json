{
  "name": "new2canada-ui-build",
  "private": true,
  "description": "Rebuilds src/main/resources/static/css/tailwind.css from the project's own design tokens.",
  "scripts": {
    "build": "tailwindcss -c tailwind.config.js -i input.css -o ../src/main/resources/static/css/tailwind.css --minify"
  },
  "devDependencies": {
    "@tailwindcss/container-queries": "0.1.1",
    "@tailwindcss/forms": "0.5.9",
    "tailwindcss": "3.4.17"
  }
}
